<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="css/main.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <!-- navbar -->

    <nav class="navbar navbar-expand-lg bg-body-tertiary">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">NAJOT FOOD</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a
                class="nav-link active"
                aria-current="page"
                href="https://google.com/maps?hl=ru&gl=uz&um=1&ie=UTF-8&fb=1&sa=X&ftid=0x487bae72e7e47f69:0x6c930e96df4455fe"
                target="_blank"
                >Adress</a
              >
            </li>
          </ul>
          <form class="d-flex" role="search">
            <input
              class="form-control me-2"
              type="search"
              placeholder="Search"
              aria-label="Search"
            />
            <button class="btn btn-outline-success" type="submit">
              Search
            </button>
          </form>
        </div>
      </div>
    </nav>

    <!-- navbar  -->

    <!-- slider -->

    <div
      id="carouselExampleIndicators"
      class="carousel slide"
      data-bs-ride="carousel"
    >
      <div class="carousel-indicators">
        <button
          type="button"
          data-bs-target="#carouselExampleIndicators"
          data-bs-slide-to="0"
          class="active"
          aria-current="true"
          aria-label="Slide 1"
        ></button>
        <button
          type="button"
          data-bs-target="#carouselExampleIndicators"
          data-bs-slide-to="1"
          aria-label="Slide 2"
        ></button>
        <button
          type="button"
          data-bs-target="#carouselExampleIndicators"
          data-bs-slide-to="2"
          aria-label="Slide 3"
        ></button>
        <button
          type="button"
          data-bs-target="#carouselExampleIndicators"
          data-bs-slide-to="3"
          aria-label="Slide 4"
        ></button>
      </div>
      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="images/burger.jpg" class="d-block w-100" alt="..." />
        </div>
        <div class="carousel-item">
          <img src="images/shawarma.avif" class="d-block w-100" alt="..." />
        </div>
        <div class="carousel-item">
          <img src="images/one.jpg" class="d-block w-100" alt="..." />
        </div>
        <div class="carousel-item">
          <img src="images/pizza.jpg" class="d-block w-100" alt="..." />
        </div>
      </div>
      <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#carouselExampleIndicators"
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#carouselExampleIndicators"
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>

    <!-- slider -->

    <!-- add -->

    <div class="container">
      <!-- button -->
      <button
        type="button"
        class="btn btn-primary mt-5 ggtort"
        data-bs-toggle="modal"
        data-bs-target="#exampleModal"
      >
        ADD NEW FOOD
      </button>
      <!-- button -->

      <div
        class="modal fade"
        id="exampleModal"
        tabindex="-1"
        aria-labelledby="exampleModalLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="exampleModalLabel">ADD FOOD</h1>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body">
              <!-- form  -->

              <form action="http://four-oy-9-dars-uy-vazifa-1.onrender.com/add_new_food" method="post">
                <div class="mb-3">
                  <label for="title-input" class="form-label">Title</label>
                  <input
                    type="text"
                    class="form-control"
                    id="title-input"
                    name="title"
                  />
                </div>
                <div class="mb-3">
                  <label for="price-input" class="form-label">price</label>
                  <input
                    type="text"
                    class="form-control"
                    id="price-input"
                    name="price"
                  />
                </div>
                <div class="mb-3">
                  <label for="discription-input" class="form-label"
                    >discription</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="discription-input"
                    name="discription"
                  />
                </div>
                <div class="mb-3">
                  <label for="calories-input" class="form-label"
                    >calories</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="calories-input"
                    name="calories"
                  />
                </div>
                <div class="modal-footer">
                  <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                  >
                    Close
                  </button>
                  <button type="submit" class="btn btn-primary">
                    Save changes
                  </button>
                </div>
              </form>

              <!-- form  -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- add -->

    <!-- card -->

    <div class="container cardss">
      <h1 class="mb-5 mt-5 RED">MENU</h1>
      <div
        class="card-box pb-5 mb-5 mt-5 d-flex justify-content-evenly gap-5 flex-wrap"
      >
        <% menu.forEach((food, index) => { %>
        <div class="card" style="width: 18rem">
          <img
            src="https://picsum.photos/200/200?random=<%= index %>"
            class="card-img-top"
            alt="..."
          />
          <div class="card-body">
            <h4 class="card-title"><%= food.title %></h4>
            <p class="card-text"><%= food.price %></p>
            <a href="#" class="btn btn-primary">see more for food</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- card -->

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
